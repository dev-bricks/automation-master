{
  "schema": "ellmos.module.v2",
  "id": "automation-master",
  "display_name": "Automation Master",
  "version": "0.1.1",
  "category": "control",
  "kind": "library",
  "status": "experimental",
  "visibility": "private",
  "description": "Local-first registry, reward policy, budget, credit, governance receipts, and separately bounded runtime observation for scheduled automations.",
  "package": "automation-master",
  "entrypoints": {
    "cli": "python -m automation_master",
    "python": "automation_master.AutomationMaster"
  },
  "provides": [
    "automation.registry",
    "automation.family",
    "automation.reward",
    "automation.budget",
    "automation.credit",
    "automation.runtime.observe",
    "automation.runtime.receipt",
    "automation.runtime.statistics"
  ],
  "requires": [],
  "optional": [
    "automation.schedule",
    "sync.files",
    "sync.database"
  ],
  "conflicts": [],
  "surfaces": [
    "library",
    "cli"
  ],
  "state": {
    "ownership": "module",
    "location": "user-home"
  },
  "boundaries": {
    "network": "none",
    "data": "application-defined",
    "platforms": [
      "windows",
      "macos",
      "linux"
    ]
  },
  "source_of_truth": {
    "type": "git-repository",
    "path": ".",
    "repository": "https://github.com/dev-bricks/automation-master.git"
  },
  "adapters": [
    {
      "type": "seam",
      "id": "ellmos-scheduler-credit-gate",
      "target": "automation.schedule",
      "status": "contract",
      "note": "Narrow preflight and local credit reservation seam; no scheduler logic."
    },
    {
      "type": "seam",
      "id": "system-gap-master-deployment-manifest",
      "target": "sync.files",
      "status": "contract",
      "note": "Discovery and import-plan contract; disabled or shadow by default."
    },
    {
      "type": "seam",
      "id": "sqlite-transit-sync-event-merge",
      "target": "sync.database",
      "status": "contract",
      "note": "Append-only event merge policy for verified closed snapshots."
    },
    {
      "type": "seam",
      "id": "ellmos-scheduler-runtime-readback",
      "target": "automation.runtime.observe",
      "status": "implemented",
      "note": "Read-only immutable scheduler run readback; no scheduling, dispatch, output, or error export."
    },
    {
      "type": "seam",
      "id": "provider-json-runtime-readback",
      "target": "automation.runtime.observe",
      "status": "implemented",
      "note": "Bounded provider-native JSON readback exposing only selected metadata and a SHA-256 digest."
    }
  ]
}
